<mxfile host="Electron" pages="2">
  <diagram name="Page-1" id="mVQZ5atYtjNeh3tbtbof">
    <mxGraphModel dx="3258" dy="1650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% Core Entities\n    STUDENT ||--o{ ENROLLMENT : enrolls\n    COURSE ||--o{ ENROLLMENT : contains\n    TEACHER ||--o{ COURSE : teaches\n    DEPARTMENT ||--o{ COURSE : offers\n    DEPARTMENT ||--o{ TEACHER : employs\n    STUDENT ||--o{ ATTENDANCE : has\n    COURSE ||--o{ ATTENDANCE : tracks\n    STUDENT ||--o{ GRADE : receives\n    COURSE ||--o{ GRADE : includes\n    TEACHER ||--o{ ASSIGNMENT : creates\n    COURSE ||--o{ ASSIGNMENT : has\n    STUDENT ||--o{ SUBMISSION : submits\n    ASSIGNMENT ||--o{ SUBMISSION : receives\n    STUDENT ||--o{ PAYMENT : makes\n    COURSE ||--o{ SCHEDULE : has\n    CLASSROOM ||--o{ SCHEDULE : books\n    SEMESTER ||--o{ COURSE : contains\n    STUDENT ||--o{ PARENT_GUARDIAN : has\n    PARENT_GUARDIAN ||--o{ STUDENT : guardian_of\n    TEACHER ||--o{ OFFICE_HOURS : holds\n    STUDENT ||--o{ ADVISEMENT : receives\n    TEACHER ||--o{ ADVISEMENT : provides\n\n    %% STUDENT Entity\n    STUDENT {\n        int student_id PK\n        string first_name\n        string last_name\n        string email\n        string phone\n        date date_of_birth\n        string address\n        date enrollment_date\n        string status\n        int department_id FK\n    }\n\n    %% TEACHER Entity\n    TEACHER {\n        int teacher_id PK\n        string first_name\n        string last_name\n        string email\n        string phone\n        date hire_date\n        string specialization\n        string office_location\n        int department_id FK\n    }\n\n    %% DEPARTMENT Entity\n    DEPARTMENT {\n        int department_id PK\n        string department_name\n        string head_of_department\n        string location\n        string phone\n    }\n\n    %% COURSE Entity\n    COURSE {\n        int course_id PK\n        string course_code\n        string course_name\n        string description\n        int credit_hours\n        int max_capacity\n        int teacher_id FK\n        int department_id FK\n        int semester_id FK\n    }\n\n    %% ENROLLMENT Entity\n    ENROLLMENT {\n        int enrollment_id PK\n        int student_id FK\n        int course_id FK\n        date enrollment_date\n        string status\n        float final_grade\n    }\n\n    %% ATTENDANCE Entity\n    ATTENDANCE {\n        int attendance_id PK\n        int student_id FK\n        int course_id FK\n        date attendance_date\n        string status\n        string remarks\n    }\n\n    %% GRADE Entity\n    GRADE {\n        int grade_id PK\n        int student_id FK\n        int course_id FK\n        float score\n        string grade_letter\n        string assessment_type\n        date date_recorded\n    }\n\n    %% ASSIGNMENT Entity\n    ASSIGNMENT {\n        int assignment_id PK\n        int course_id FK\n        int teacher_id FK\n        string title\n        string description\n        date due_date\n        int total_points\n    }\n\n    %% SUBMISSION Entity\n    SUBMISSION {\n        int submission_id PK\n        int assignment_id FK\n        int student_id FK\n        date submission_date\n        float score\n        string feedback\n        string file_path\n    }\n\n    %% PAYMENT Entity\n    PAYMENT {\n        int payment_id PK\n        int student_id FK\n        decimal amount\n        date payment_date\n        string payment_method\n        string semester\n        string status\n    }\n\n    %% SCHEDULE Entity\n    SCHEDULE {\n        int schedule_id PK\n        int course_id FK\n        int classroom_id FK\n        string day_of_week\n        time start_time\n        time end_time\n        string semester\n    }\n\n    %% CLASSROOM Entity\n    CLASSROOM {\n        int classroom_id PK\n        string building\n        string room_number\n        int capacity\n        string equipment\n    }\n\n    %% SEMESTER Entity\n    SEMESTER {\n        int semester_id PK\n        string semester_name\n        date start_date\n        date end_date\n        string academic_year\n    }\n\n    %% PARENT_GUARDIAN Entity\n    PARENT_GUARDIAN {\n        int guardian_id PK\n        string first_name\n        string last_name\n        string relationship\n        string email\n        string phone\n        string occupation\n    }\n\n    %% OFFICE_HOURS Entity\n    OFFICE_HOURS {\n        int office_hours_id PK\n        int teacher_id FK\n        string day_of_week\n        time start_time\n        time end_time\n        string location\n    }\n\n    %% ADVISEMENT Entity\n    ADVISEMENT {\n        int advisement_id PK\n        int student_id FK\n        int teacher_id FK\n        date meeting_date\n        string topic\n        string notes\n    }\n\n    %% EXAM Entity\n    EXAM {\n        int exam_id PK\n        int course_id FK\n        string exam_type\n        date exam_date\n        time duration\n        string location\n        int total_marks\n    }\n\n    %% LIBRARY_BOOK Entity\n    LIBRARY_BOOK {\n        int book_id PK\n        string isbn\n        string title\n        string author\n        string publisher\n        int publication_year\n        string category\n        int copies_available\n    }\n\n    %% BOOK_LOAN Entity\n    BOOK_LOAN {\n        int loan_id PK\n        int book_id FK\n        int student_id FK\n        date checkout_date\n        date due_date\n        date return_date\n        string status\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="XmJKYjr-iCfZ41FoZ6Nk-1">
