  <diagram id="Uvud50IIggPBLyTjlkwX" name="DB Diagram">
    <mxGraphModel dx="1123" dy="569" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    %% ─────────────────── Auth &amp; RAG ───────────────────\n    USER {\n        int id PK\n        string name\n        string email UK\n        string password\n        string role\n        date createdAt\n        date updatedAt\n    }\n\n    EMBEDDING {\n        int id PK\n        string sourceType\n        int sourceId\n        string content\n        vector embedding\n        date createdAt\n    }\n\n    %% ─────────────── Academic structure ───────────────\n    DEPARTMENT {\n        int id PK\n        string departmentName UK\n        string headOfDepartment\n        string location\n        string phone\n        date createdAt\n        date updatedAt\n    }\n\n    SEMESTER {\n        int id PK\n        string semesterName\n        date startDate\n        date endDate\n        string academicYear\n        date createdAt\n        date updatedAt\n    }\n\n    TEACHER {\n        int id PK\n        string firstName\n        string lastName\n        string email UK\n        string phone\n        date hireDate\n        string specialization\n        string officeLocation\n        int departmentId FK\n        date createdAt\n        date updatedAt\n    }\n\n    STUDENT {\n        int id PK\n        string firstName\n        string lastName\n        string email UK\n        string phone\n        date dateOfBirth\n        string address\n        date enrollmentDate\n        string status\n        int departmentId FK\n        date createdAt\n        date updatedAt\n    }\n\n    COURSE {\n        int id PK\n        string courseCode UK\n        string courseName\n        string description\n        int creditHours\n        int maxCapacity\n        int teacherId FK\n        int departmentId FK\n        int semesterId FK\n        date createdAt\n        date updatedAt\n    }\n\n    %% ─────────── Enrollment · Attendance · Grading ───────────\n    ENROLLMENT {\n        int id PK\n        int studentId FK, UK\n        int courseId FK, UK\n        date enrollmentDate\n        string status\n        float finalGrade\n        date createdAt\n        date updatedAt\n    }\n\n    ATTENDANCE {\n        int id PK\n        int studentId FK\n        int courseId FK\n        date attendanceDate\n        string status\n        string remarks\n        date createdAt\n        date updatedAt\n    }\n\n    GRADE {\n        int id PK\n        int studentId FK\n        int courseId FK\n        float score\n        string gradeLetter\n        string assessmentType\n        date dateRecorded\n        date createdAt\n        date updatedAt\n    }\n\n    %% ─────────── Assignments &amp; Submissions ───────────\n    ASSIGNMENT {\n        int id PK\n        int courseId FK\n        int teacherId FK\n        string title\n        string description\n        date dueDate\n        int totalPoints\n        date createdAt\n        date updatedAt\n    }\n\n    SUBMISSION {\n        int id PK\n        int assignmentId FK, UK\n        int studentId FK, UK\n        date submissionDate\n        float score\n        string feedback\n        string filePath\n        date createdAt\n        date updatedAt\n    }\n\n    %% ─────────────────── Payments ───────────────────\n    PAYMENT {\n        int id PK\n        int studentId FK\n        decimal amount\n        date paymentDate\n        string paymentMethod\n        string semester\n        string status\n        date createdAt\n        date updatedAt\n    }\n\n    %% ───────────── Scheduling &amp; facilities ─────────────\n    SCHEDULE {\n        int id PK\n        int courseId FK\n        int classroomId FK\n        string dayOfWeek\n        time startTime\n        time endTime\n        string semester\n        date createdAt\n        date updatedAt\n    }\n\n    CLASSROOM {\n        int id PK\n        string building UK\n        string roomNumber UK\n        int capacity\n        string equipment\n        date createdAt\n        date updatedAt\n    }\n\n    EXAM {\n        int id PK\n        int courseId FK\n        string examType\n        date examDate\n        time duration\n        string location\n        int totalMarks\n        date createdAt\n        date updatedAt\n    }\n\n    %% ───────── Guardians · Advising · Office hours ─────────\n    PARENTGUARDIAN {\n        int id PK\n        string firstName\n        string lastName\n        string relationship\n        string email\n        string phone\n        string occupation\n        date createdAt\n        date updatedAt\n    }\n\n    STUDENTGUARDIAN {\n        int id PK\n        int studentId FK, UK\n        int guardianId FK, UK\n        date createdAt\n    }\n\n    OFFICEHOURS {\n        int id PK\n        int teacherId FK\n        string dayOfWeek\n        time startTime\n        time endTime\n        string location\n        date createdAt\n        date updatedAt\n    }\n\n    ADVISEMENT {\n        int id PK\n        int studentId FK\n        int teacherId FK\n        date meetingDate\n        string topic\n        string notes\n        date createdAt\n        date updatedAt\n    }\n\n    %% ─────────────────── Library ───────────────────\n    LIBRARYBOOK {\n        int id PK\n        string isbn UK\n        string title\n        string author\n        string publisher\n        int publicationYear\n        string category\n        int copiesAvailable\n        date createdAt\n        date updatedAt\n    }\n\n    BOOKLOAN {\n        int id PK\n        int bookId FK\n        int studentId FK\n        date checkoutDate\n        date dueDate\n        date returnDate\n        string status\n        date createdAt\n        date updatedAt\n    }\n\n    %% ═══════════════ Relationships ═══════════════\n    %% Department &amp; Semester\n    DEPARTMENT ||--o{ TEACHER : \&quot;employs\&quot;\n    DEPARTMENT o|--o{ STUDENT : \&quot;enrolls\&quot;\n    DEPARTMENT ||--o{ COURSE : \&quot;offers\&quot;\n    SEMESTER ||--o{ COURSE : \&quot;hosts\&quot;\n\n    %% Teacher\n    TEACHER o|--o{ COURSE : \&quot;teaches\&quot;\n    TEACHER ||--o{ ASSIGNMENT : \&quot;creates\&quot;\n    TEACHER ||--o{ OFFICEHOURS : \&quot;holds\&quot;\n    TEACHER ||--o{ ADVISEMENT : \&quot;advises\&quot;\n\n    %% Student\n    STUDENT ||--o{ ENROLLMENT : \&quot;enrolls\&quot;\n    STUDENT ||--o{ ATTENDANCE : \&quot;attends\&quot;\n    STUDENT ||--o{ GRADE : \&quot;receives\&quot;\n    STUDENT ||--o{ SUBMISSION : \&quot;submits\&quot;\n    STUDENT ||--o{ PAYMENT : \&quot;pays\&quot;\n    STUDENT ||--o{ STUDENTGUARDIAN : \&quot;links to\&quot;\n    STUDENT ||--o{ ADVISEMENT : \&quot;meets\&quot;\n    STUDENT ||--o{ BOOKLOAN : \&quot;borrows\&quot;\n\n    %% Course\n    COURSE ||--o{ ENROLLMENT : \&quot;has\&quot;\n    COURSE ||--o{ ATTENDANCE : \&quot;tracks\&quot;\n    COURSE ||--o{ GRADE : \&quot;has\&quot;\n    COURSE ||--o{ ASSIGNMENT : \&quot;includes\&quot;\n    COURSE ||--o{ SCHEDULE : \&quot;scheduled as\&quot;\n    COURSE ||--o{ EXAM : \&quot;tested by\&quot;\n\n    %% Assignment, classroom, guardians, library\n    ASSIGNMENT ||--o{ SUBMISSION : \&quot;receives\&quot;\n    CLASSROOM ||--o{ SCHEDULE : \&quot;hosts\&quot;\n    PARENTGUARDIAN ||--o{ STUDENTGUARDIAN : \&quot;linked via\&quot;\n    LIBRARYBOOK ||--o{ BOOKLOAN : \&quot;lent via\&quot;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="yvG1_clMlBBjllEATf1f-1">
